# Build step: embeds fx/catalog.json, fx/_common.hlsl, fx/_main.hlsl and every
# fx/<id>/effect.json + fx/<id>/<id>.hlsl into one generated header, so the
# engine never reads effect files at run time (show-safe: nothing to lose on disk).
# Usage: cmake -DFX_DIR=<repo>/fx -DOUT=<header> -P embed_fx.cmake

function(append_literal out_var path)
    file(READ "${path}" body)
    # CMake would eat backslashes on the way to the header: keep fx/ files free of them.
    string(FIND "${body}" "\\" bs)
    if(NOT bs EQUAL -1)
        message(FATAL_ERROR "${path}: no backslashes in fx/ files, please (they do not survive embedding)")
    endif()
    string(LENGTH "${body}" n)
    set(acc "")
    set(pos 0)
    # MSVC: one string literal piece must stay under 16 KB; adjacent raw literals concatenate.
    while(pos LESS n)
        string(SUBSTRING "${body}" ${pos} 8000 piece)
        string(APPEND acc "R\"FXSRC(${piece})FXSRC\"\n")
        math(EXPR pos "${pos} + 8000")
    endwhile()
    if(n EQUAL 0)
        set(acc "\"\"")
    endif()
    set(${out_var} "${acc}" PARENT_SCOPE)
endfunction()

set(text "// Generated by src/engine/fx/embed_fx.cmake from fx/. Do not edit.\n#pragma once\n\n")
string(APPEND text "namespace himmel::fx::embedded {\n\nstruct File {\n    const char* id;\n    const char* json;\n    const char* hlsl;\n};\n\n")
append_literal(lit "${FX_DIR}/catalog.json")
string(APPEND text "inline constexpr const char* kCatalog =\n${lit};\n")
append_literal(lit "${FX_DIR}/_common.hlsl")
string(APPEND text "inline constexpr const char* kCommon =\n${lit};\n")
append_literal(lit "${FX_DIR}/_main.hlsl")
string(APPEND text "inline constexpr const char* kMain =\n${lit};\n\n")

file(GLOB dirs LIST_DIRECTORIES true RELATIVE "${FX_DIR}" "${FX_DIR}/*")
list(SORT dirs)
set(count 0)
string(APPEND text "inline constexpr File kFiles[] = {\n")
foreach(d IN LISTS dirs)
    if(IS_DIRECTORY "${FX_DIR}/${d}" AND EXISTS "${FX_DIR}/${d}/effect.json")
        append_literal(js "${FX_DIR}/${d}/effect.json")
        if(EXISTS "${FX_DIR}/${d}/${d}.hlsl")
            append_literal(hl "${FX_DIR}/${d}/${d}.hlsl")
        else()
            set(hl "\"\"")
        endif()
        string(APPEND text "    {\"${d}\",\n${js},\n${hl}},\n")
        math(EXPR count "${count} + 1")
    endif()
endforeach()
string(APPEND text "};\ninline constexpr int kFileCount = ${count};\n\n}  // namespace himmel::fx::embedded\n")

# Only rewrite when the content changed (keeps incremental builds quiet).
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
