 "badge": "◎ HIMMEL · CLIPS",
 "hardware": {
  "maker": "Akai Professional",
  "model": "APC20 (2010), UPC 0 825213 00251 7",
  "usb": "09e8:007b",
  "power": "needs its 12 V DC 2 A adapter (rear DC input, per Akai's APC20 Quickstart Guide); USB carries MIDI only",
  "note": "Class-compliant USB-MIDI. Works with the hardware; not affiliated with Akai Professional or Ableton."
 },
 "driver": "midi-apc",
 "page": "apc20_live.html",
 "role": "secondary",
 "protocol": {
  "transport": "USB-MIDI (WinMM on Windows; the port is exclusive, close Ableton Live first). Port name 'Akai APC20' (expected).",
  "init": "identity request F0 7E 7F 06 01 F7 -> reply F0 7E <dev> 06 02 47 7B 00 19 ... F7 (byte 13 = device id); then mode F0 47 <dev> 7B 60 00 04 <mode> <maj> <min> <bug> F7, mode 40 generic / 41 Ableton (host owns the LEDs) / 42 alternate Ableton / 43 note mode",
  "input": "buttons = note on (vel 127) / note off; clip grid notes 53..57 on channel = track; faders CC 7 per track channel, master CC 14; Cue Level CC 47 relative two's complement",
  "leds": "note on to the same note/channel: clip grid 0 off, 1 green, 2 green blink, 3 red, 4 red blink, 5 amber, 6 amber blink; other LEDs 0 off, 1 on, 2 blink",
  "sources": "Ableton's APC20 MIDI Remote Script (as decompiled on GitHub, facts only) and Akai's APC20 Quickstart Guide; see THIRD_PARTY_NOTICES.md",
  "unverified": "LED colours of the single-colour rows, note-off velocity and the note-mode grid on the real unit: checked with the LED test and map learning when the owner has power"
 },
