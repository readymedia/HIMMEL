  "format": "himmel-weapon/1",
  "id": "lumi",
  "name": "LUMI Keys",
  "badge": "◎ HIMMEL · KEYS",
  "hardware": {
    "maker": "ROLI",
    "model": "LUMI Keys (Studio Edition / Block)",
    "usb": "2af4:0e00",
    "note": "Class-compliant USB-MIDI (and BLE MIDI), part of the BLOCKS family. Works with the hardware; not affiliated with ROLI or Luminary."
  },
  "driver": "midi-blocks",
  "protocol": {
    "transport": "USB-MIDI (WinMM on Windows; ports are exclusive, close ROLI Connect / Dashboard)",
    "keys": "the block's own key handler sends MPE: note on/off with strike velocity, channel pressure, pitch bend (glide); 24 keys, key 0 = note 48 + 12 * octave",
    "api": "BLOCKS SysEx, as the Lightpad; buttons 0 = mode, 1 = octave down, 2 = octave up",
    "leds": "one RGB LED per key, drawn by Himmel's renderer with fillPixel(colour, key, 0) from a 48-byte RGB565 heap (firmware 1.3.0 or newer)"
  },
  "map": null,
  "status": "simulated; protocol from ROLI's reference code and blocksd, not yet checked on the owner's LUMI",
