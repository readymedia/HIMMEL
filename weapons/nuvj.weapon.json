 "badge": "◎ HIMMEL · VJ",
 "hardware": {
  "maker": "Numark (software by ArKaos)",
  "model": "NuVJ (2008)",
  "usb": "to be read from the owner's unit",
  "note": "Class-compliant USB-MIDI, bus powered (or 6 V 1 A DC). Works with the hardware; not affiliated with Numark or ArKaos."
 },
 "driver": "midi-nuvj",
 "page": "nuvj_live.html",
 "protocol": {
  "transport": "USB-MIDI (WinMM on Windows; ports are exclusive, close the NuVJ / GrandVJ software)",
  "input": "buttons and pads = note on/off, knobs = CC (absolute), BANK, MASTER FX and jog wheels = CC (relative), BANK push = notes 2/3, speed faders and crossfader = pitch bend on channels 1-3, front switches = CC 18 / note 33. From a public forum post, confirmed by the mappings.xml inside the owner's NuVJ 1.0 software; checked on the owner's unit into nuvj_map.json.",
  "feedback": "SysEx F0 00 01 3F 7F 20 <cmd> 00 <len> <data> F7 (00 01 3F = Numark). cmd 60 init (01 01 01 00), 01 LCD text (8 ASCII), 02 LCD segments (64 bytes), 03 LEDs (8 bytes, one bit per LED), 7A contrast 0..99 (7B = stored; Himmel never sends it). Read from the owner's NuVJ 1.0 software by static analysis; not yet checked on the unit.",
  "lcd": "custom segment LCD: 8 dot-matrix characters (cmd 01) plus segment memory (cmd 02): the software's 2-digit number is known; the other segments are learned with the segment hunt."
 },
 "map": "nuvj_map.json",
 "status": "simulated with the real feedback protocol; hardware probe, map learning and segment hunt ready; not yet checked on the owner's unit",
