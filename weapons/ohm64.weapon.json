{
 "format": "himmel-weapon/1",
 "id": "ohm64",
 "name": "Ohm64",
 "badge": "◎ HIMMEL · 64",
 "hardware": {
  "maker": "Livid Instruments",
  "model": "Ohm64, first version (2009, single-colour blue LEDs; not the later OhmRGB)",
  "usb": "to be read from the owner's unit",
  "note": "Class-compliant USB-MIDI, bus powered; MIDI IN/OUT DIN on the back (second USB port 'Ohm64 External'). Works with the hardware; not affiliated with Livid Instruments."
 },
 "driver": "midi-ohm64",
 "page": "ohm64_live.html",
 "protocol": {
  "transport": "USB-MIDI (WinMM on Windows; the port is exclusive, close the Livid Editor)",
  "input": "81 buttons = note on/off (or CC), 25 analog inputs (16 knobs, 8 faders, crossfader) = CC 7-bit (or 14-bit CC / pitch bend), all on the basic channel. Fully remappable; the device reports its own map on request (SysEx 07.0B buttons, 07.0A analog).",
  "feedback": "75 single-colour LEDs (64 grid, XL/XR, 8 mutes, BPM; F1-F6 have none). SysEx F0 00 01 61 02 <cmd> ... F7 (00 01 61 = Livid, 02 = Ohm64): 04 sets all LEDs (6 columns x 14 rows, 1 = off), 07.xx requests. LEDs also follow incoming notes/CCs through the device's LED input map. CC 27 = backlight dimmer, CC 31 (+63) = logo dimmer. From the Ohm64 user guide; not yet checked on the unit."
 },
 "map": "ohm64_map.json",
 "status": "simulated from the user guide; read-only probe, map readback, map learning and LED hunt ready; not yet checked on the owner's unit",
